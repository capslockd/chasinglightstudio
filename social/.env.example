# Copy this file to social/.env and fill in your values. social/.env is gitignored.

# Public site base URL (no trailing slash) — must match your GitHub Pages / custom domain.
SITE_URL=https://chasinglightstudios.com.au

# Facebook Page ID and a Page Access Token with pages_manage_posts + pages_read_engagement scopes.
# Get these from a Meta App you create at developers.facebook.com (Graph API Explorer works for testing).
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Instagram Business/Creator account ID linked to the Facebook Page above.
# Requires instagram_basic + instagram_content_publish scopes on the same access token.
IG_USER_ID=
